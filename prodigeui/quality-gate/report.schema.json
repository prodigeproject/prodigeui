{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prodigeui.dev/schemas/report.schema.json",
  "title": "ProdigeUI Quality Gate Report",
  "description": "Schema for executable and manual Quality Gate results.",
  "type": "object",
  "required": ["artifact", "generatedAt", "overall", "summary", "criteria"],
  "additionalProperties": false,
  "properties": {
    "artifact": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "overall": {
      "type": "string",
      "enum": ["pass", "fail", "incomplete"],
      "description": "Pass has no failing or unevaluated criteria. Incomplete means manual evidence is still required."
    },
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "flag", "notEvaluable"],
      "additionalProperties": false,
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "flag": { "type": "integer", "minimum": 0 },
        "notEvaluable": { "type": "integer", "minimum": 0 }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/criterionResult" }
    }
  },
  "definitions": {
    "criterionResult": {
      "type": "object",
      "required": ["id", "status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "status": { "type": "string", "enum": ["pass", "fail", "flag", "not-evaluable"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "issue": { "type": "string" },
        "location": { "type": "string" },
        "recommendation": { "type": "string" }
      }
    }
  }
}
