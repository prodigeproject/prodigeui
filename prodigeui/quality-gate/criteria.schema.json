{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prodigeui.dev/schemas/criteria.schema.json",
  "title": "ProdigeUI Quality Criteria",
  "type": "object",
  "required": ["description", "criteria"],
  "additionalProperties": false,
  "properties": {
    "description": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "description", "type", "severity"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "category": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["automated", "manual"] },
          "severity": { "type": "string", "enum": ["fail", "flag"] },
          "appliesWhen": { "type": "string" }
        }
      }
    }
  }
}
