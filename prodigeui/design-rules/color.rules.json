{
  "color": {
    "contrast": { "normal": 4.5, "large": 3.0, "nonText": 3.0 },
    "maxPaletteColors": 7,
    "roles": ["primary", "secondary", "neutral", "success", "warning", "error", "info"],
    "neverRelySoleyOnColor": true,
    "primaryCtaDistinction": 3.0,
    "darkMode": {
      "neverPureBlack": true,
      "elevatedSurfacesLighter": true,
      "maintainHueIdentity": true
    },
    "accessibilityNotes": "Color must always be paired with text, icon, or pattern to convey meaning (WCAG 1.4.1)"
  }
