{
  "typography": {
    "scaleRatio": 1.25,
    "scaleRatioName": "major-third",
    "lineHeightRange": { "min": 1.3, "max": 1.7 },
    "lineHeightBody": {
      "below20px": 1.5,
      "20to31px": 1.4,
      "32pxAndAbove": 1.25,
      "source": "Bringhurst Elements of Typographic Style: larger type needs tighter leading; Butterick confirms tiered approach"
    },
    "verticalRhythmGrid": 4,
    "verticalRhythmGridNote": "All computed line-heights snap to nearest 4px increment for vertical rhythm alignment",
    "minLineHeightGap": 4,
    "minLineHeightGapNote": "Minimum gap between lines is fontSize + 4px to ensure readability at all sizes",
    "lineHeightHeading": 1.15,
    "allowedWeights": [400, 500, 600, 700],
    "maxWeightsPerPage": 3,
    "allowedPairings": [
      {
        "id": "single-family-ui",
        "heading": "disciplined UI sans",
        "body": "same UI sans",
        "useCase": "dense functional application surfaces"
      },
      {
        "id": "operational-product",
        "heading": "distinctive editorial or variable grotesk",
        "body": "neutral UI sans",
        "annotation": "optional mono or tabular voice",
        "useCase": "technical products and product-led landing pages"
      },
      {
        "id": "expressive-editorial",
        "heading": "identity/display face",
        "body": "editorial reading face",
        "annotation": "optional UI/control face",
        "useCase": "studio, portfolio, campaign, and editorial work"
      }
    ],
    "maxPrimaryFontsPerProject": 2,
    "allowOneAnnotationFont": true,
    "maxFontsPerProject": 3,
    "minFontSizePx": 14,
    "minCaptionSizePx": 12,
    "optimalMeasure": { "min": 45, "max": 75, "ideal": 66, "unit": "ch" },
    "letterSpacing": {
      "headingsLarge": "-0.02em",
      "headingsSmall": "-0.01em",
      "bodyNormal": "0em",
      "smallText": "0.01em"
    },
    "roleIntegrity": {
      "authority": "canonical/generation.contract.json#/typography",
      "declareJobsBeforeSelection": true,
      "displayFallbackMustPreserveVoice": true,
      "operationalProductDisplayTrackingRangeEm": { "min": -0.06, "max": -0.015 },
      "requireRenderedHeadlineTest": true,
      "requireComputedFontVerification": true
    },
    "fontDelivery": {
      "standalone": "bundle licensed fonts or select a verified system stack",
      "waitForDocumentFontsReady": true,
      "recordSourceAndLicense": true
    },
    "typeScalePresets": {
      "dense": {
        "ratio": 1.2,
        "ratioName": "minor-third",
        "baseSize": 14,
        "useCase": "Data-heavy dashboards, admin tools, compact UIs"
      },
      "default": {
        "ratio": 1.25,
        "ratioName": "major-third",
        "baseSize": 16,
        "useCase": "General purpose, balanced reading/scanning"
      },
      "editorial": {
        "ratio": 1.333,
        "ratioName": "perfect-fourth",
        "baseSize": 18,
        "useCase": "Long-form content, marketing, editorial layouts"
      },
      "source": "Astryx audit: type scale presets ensure ratio matches content density"
    }
  }
}
